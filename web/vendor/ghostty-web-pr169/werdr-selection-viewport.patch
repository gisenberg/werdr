   describe('select() API', () => {
+    test('programmatic selections follow the visible viewport after scrollback accumulates', async () => {
+      if (!container) throw new Error('Selection tests require a DOM');
+      const term = await createIsolatedTerminal({ cols: 20, rows: 4, scrollback: 1000 });
+      term.open(container);
+      try {
+        for (let row = 0; row < 20; row++) term.write(`ROW_${String(row).padStart(2, '0')}\r\n`);
+        const manager = (term as any).selectionManager;
+        expect(term.wasmTerm!.getScrollbackLength()).toBeGreaterThan(4);
+        for (const offset of [0, 5]) {
+          (term as any).viewportY = offset;
+          term.select(0, 1, 6);
+          expect(term.getSelection()).toBe(`ROW_${String(18 - offset).padStart(2, '0')}`);
+          expect(manager.getSelectionCoords()).toEqual({
+            startCol: 0,
+            startRow: 1,
+            endCol: 5,
+            endRow: 1,
+          });
+          manager.clearDirtySelectionRows();
+          term.select(0, 2, 6);
+          expect(manager.getDirtySelectionRows().has(1)).toBe(true);
+          term.selectAll();
+          expect(manager.getSelectionCoords()).toEqual({
+            startCol: 0,
+            startRow: 0,
+            endCol: 19,
+            endRow: 3,
+          });
+        }
+      } finally {
+        term.dispose();
+      }
+    });
+
+    test('programmatic selection bounds oversized and invalid lengths', async () => {
+      if (!container) throw new Error('Selection tests require a DOM');
+      const term = await createIsolatedTerminal({ cols: 20, rows: 4 });
+      term.open(container);
+      try {
+        term.select(18, 2, Number.MAX_SAFE_INTEGER);
+        expect(term.getSelectionPosition()).toEqual({
+          start: { x: 18, y: 2 },
+          end: { x: 19, y: 3 },
+        });
+        for (const length of [0, -1, Infinity, NaN]) {
+          term.select(0, 0, 1);
+          term.select(0, 0, length);
+          expect(term.hasSelection()).toBe(false);
+        }
+      } finally {
+        term.dispose();
+      }
+    });
+
