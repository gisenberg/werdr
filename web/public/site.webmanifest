{
  "name": "werdr",
  "short_name": "werdr",
  "description": "Private-network browser client for herdr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14191b",
  "theme_color": "#14191b",
  "orientation": "any",
  "icons": [
