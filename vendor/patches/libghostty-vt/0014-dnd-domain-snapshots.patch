+test "dnd snapshot future requests conclusion and leave are identical" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var source: ?*drop.State = null;
+    defer if (source) |s| s.destroy(alloc);
+    var a: std.Io.Writer.Allocating = .init(alloc);
+    defer a.deinit();
+    var b: std.Io.Writer.Allocating = .init(alloc);
+    defer b.deinit();
+    _ = try send(&source, &a.writer, "t=a:i=42", "text/plain");
+    const items = [_]drop.State.Item{.{ .mime = "text/plain", .data = "hello" }} ** 17;
+    try source.?.dragDrop(alloc, &a.writer, .{
+        .cell_x = 0,
+        .cell_y = 0,
+        .pixel_x = 0,
+        .pixel_y = 0,
+        .operations = .{ .copy = true },
+    }, &items);
+    try testing.expectEqual(@as(usize, 16), source.?.drop.items.?.len);
+    const bytes = try encode(alloc, source.?, 4096);
+    defer alloc.free(bytes);
+    var restored: ?*drop.State = try decode(alloc, bytes, 4096);
+    defer if (restored) |s| s.destroy(alloc);
+    a.clearRetainingCapacity();
+    try source.?.dragLeave(alloc, &a.writer);
+    try restored.?.dragLeave(alloc, &b.writer);
+    try testing.expectEqual(@as(usize, 0), b.written().len);
+    for ([_][]const u8{ "t=r:x=1:i=7", "t=r:x=16", "t=r:x=17", "t=r:o=1", "t=r:o=1", "t=r:x=1" }, 0..) |meta, i| {
+        try testing.expectEqual(try send(&source, &a.writer, meta, null), try send(&restored, &b.writer, meta, null));
+        try testing.expectEqualSlices(u8, a.written(), b.written());
+        if (i == 0) try testing.expectEqualStrings("\x1b]72;t=r:x=1:i=42:m=0;aGVsbG8=\x1b\\\x1b]72;t=r:x=1:i=42\x1b\\", b.written());
+        try expectEquivalent(source.?, restored.?);
+        a.clearRetainingCapacity();
+        b.clearRetainingCapacity();
+    }
+}
