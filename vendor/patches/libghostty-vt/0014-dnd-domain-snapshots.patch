+test "dnd snapshot native drop allocation failures preserve partial state" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var succeeded = false;
+    var saw_dropped_without_offer = false;
+    for (0..32) |failure_offset| {
+        var failing = testing.FailingAllocator.init(alloc, .{});
+        const native_alloc = failing.allocator();
+        const source = try native_alloc.create(drop.State);
+        source.* = .{};
+        defer source.destroy(native_alloc);
+        var output: std.Io.Writer.Allocating = .init(alloc);
+        defer output.deinit();
+        failing.fail_index = failing.alloc_index + failure_offset;
+        const result = source.dragDrop(native_alloc, &output.writer, .{
+            .cell_x = 0,
+            .cell_y = 0,
+            .pixel_x = 0,
+            .pixel_y = 0,
+            .operations = .{ .copy = true },
+        }, &.{.{ .mime = "text/plain", .data = "hello" }});
+        const bytes = try encode(alloc, source, 4096);
+        defer alloc.free(bytes);
+        const restored = try decode(alloc, bytes, 4096);
+        defer restored.destroy(alloc);
+        try expectEquivalent(source, restored);
+        if (source.drop.dropped and source.drop.offered == null) saw_dropped_without_offer = true;
+        if (result) |_| {
+            succeeded = true;
+            break;
+        } else |err| try testing.expectEqual(error.OutOfMemory, err);
+    }
+    try testing.expect(succeeded);
+    try testing.expect(saw_dropped_without_offer);
+}
+
+test "dnd snapshot acceptance exact cap and failed final terminator" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    for ([_]bool{ false, true }) |fail_terminator| {
+        var failing = testing.FailingAllocator.init(alloc, .{});
+        const native_alloc = failing.allocator();
+        const source = try native_alloc.create(drop.State);
+        source.* = .{};
+        defer source.destroy(native_alloc);
+        // Exact capacity forces the final NUL append to grow the allocation.
+        const payload = try native_alloc.alloc(u8, drop.max_mime_list_bytes);
+        @memset(payload, ' ');
+        source.drop.accepted_mimes = .fromOwnedSlice(payload);
+        source.drop.accept_in_progress = true;
+        source.drop.accepted = .move;
+        var slot: ?*drop.State = source;
+        var writer: std.Io.Writer = .fixed(&.{});
+        if (fail_terminator) {
+            failing.fail_index = failing.alloc_index;
+            failing.resize_fail_index = failing.resize_index;
+        }
+        const result = drop.handleCommand(&slot, native_alloc, &writer, .{
+            .metadata = "t=m:m=0",
+            .payload = null,
+            .terminator = .st,
+        });
+        if (fail_terminator) {
+            try testing.expectError(error.OutOfMemory, result);
+        } else {
+            try testing.expectEqual(drop.Event.acceptance, (try result).?);
+        }
+        try testing.expect(!source.drop.accept_in_progress);
+        try testing.expectEqual(drop.max_mime_list_bytes + @as(usize, @intFromBool(!fail_terminator)), source.drop.accepted_mimes.items.len);
+        try testing.expectEqual(@as(u8, 0), source.drop.accepted_mimes.items[0]);
+        const bytes = try encode(alloc, source, 2 << 20);
+        defer alloc.free(bytes);
+        const restored = try decode(alloc, bytes, 2 << 20);
+        defer restored.destroy(alloc);
+        try testing.expectEqualSlices(u8, source.drop.accepted_mimes.items, restored.drop.accepted_mimes.items);
+        try testing.expectEqual(source.drop.accepted, restored.drop.accepted);
+        try testing.expectEqual(source.drop.accept_in_progress, restored.drop.accept_in_progress);
+    }
+}
+
+test "dnd snapshot terminal reset preserves drop and clears chunking" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const Terminal = @import("../Terminal.zig");
+    var terminal = try Terminal.init(testing.io, alloc, .{ .cols = 20, .rows = 4 });
+    defer terminal.deinit(alloc);
+    var output: std.Io.Writer.Allocating = .init(alloc);
+    defer output.deinit();
+    _ = try send(&terminal.kitty_dnd, &output.writer, "t=a:i=42:m=1", "partial");
+    const before = try encode(alloc, terminal.kitty_dnd.?, 4096);
+    defer alloc.free(before);
+    const restored = try decode(alloc, before, 4096);
+    defer restored.destroy(alloc);
+    terminal.fullReset();
+    restored.chunking = .{};
+    try expectEquivalent(terminal.kitty_dnd.?, restored);
+    try testing.expectEqualStrings("partial", terminal.kitty_dnd.?.drop.registered_mimes.items);
+}
